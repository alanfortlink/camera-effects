#!/bin/bash
# camera-effects-setup — the privileged half of the Camera Effects plugin.
# Invoked through pkexec by the shell plugin (or sudo by install.sh).
#
#   install [<camera-effects-server> [<camera-effects-setup>]]  create the virtual camera now and at every boot; also
#                                   installs a root-owned copy of this script (from <camera-effects-setup>, the
#                                   user's copy) for the shell to pkexec and, when hide rules exist,
#                                   refreshes the privileged daemon copy from <camera-effects-server>
#   uninstall                       remove the boot unit, the device, the hide rules and /usr/local/lib/camera-effects
#   hide-raw on <camera-effects-server> [<key>]    hide physical webcams from apps (all, or one USB camera by
#                                   key "usb-<vid>-<pid>[-<serial>]"); only camera-effects-server may read them
#   hide-raw off [<key>]            make physical webcams (all, or that one) visible again
#   refresh-daemon <camera-effects-server>         refresh the privileged daemon copy only (rules untouched)
#   status                          print JSON status
set -euo pipefail
export LC_ALL=C  # the key/serial regexes below are ASCII classes; keep them locale-independent

LABEL="Camera Effects"
NR=20
UNIT=/etc/systemd/system/camera-effects-device.service
MODLOAD=/etc/modules-load.d/camera-effects.conf
MODPROBE=/etc/modprobe.d/camera-effects.conf
RULES_DIR=/etc/udev/rules.d
RULE_ALL=$RULES_DIR/71-camera-effects-hide-raw.rules
LIBDIR=/usr/local/lib/camera-effects
GROUP=camerad
# Camera key as built by the daemon (capture.cpp): 4 hex vid, 4 hex pid, optional
# serial of [A-Za-z0-9._]{1,64}. Anything else is refused: the key becomes part of a
# udev rule and of a file name written as root.
KEY_RE='^usb-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}(-[A-Za-z0-9._]{1,64})?$'

need_root() { [[ $EUID -eq 0 ]] || { echo "must run as root (pkexec/sudo)" >&2; exit 1; }; }
valid_key() { [[ $1 =~ $KEY_RE ]] || { echo "bad camera key: $1" >&2; exit 2; }; }

# `list` prints "OUTPUT \t CAPTURE \t NAME" rows with padded fields.
device_path() { v4l2loopback-ctl list 2>/dev/null | awk -F'\t' -v l="$LABEL" '{ gsub(/ +$/, "", $1); gsub(/ +$/, "", $3) } $3==l {print $1; exit}'; }

ensure_tools() {
  local pkgs=()
  command -v v4l2loopback-ctl >/dev/null || pkgs+=(v4l2loopback-utils)
  modinfo v4l2loopback >/dev/null 2>&1 || pkgs+=(v4l2loopback-dkms)
  if ((${#pkgs[@]})); then
    echo "Installing ${pkgs[*]}…"
    pacman -S --noconfirm --needed "${pkgs[@]}"
  fi
}

cmd_install() {
  need_root
  local bin=${1:-} src=${2:-}
  ensure_tools
  # Without any options the module creates one "Dummy video device" at every boot
  # that shows up in every app's camera list. Ask for none unless the user (or OBS)
  # already configured the module; the boot unit adds ours by label.
  if ! grep -qs '^[[:space:]]*options[[:space:]]\+v4l2loopback\b' /etc/modprobe.d/*.conf /usr/lib/modprobe.d/*.conf; then
    echo "options v4l2loopback devices=0" > "$MODPROBE"
  fi
  echo v4l2loopback > "$MODLOAD"
  modprobe v4l2loopback 2>/dev/null || true
  cat > "$UNIT" <<EOF
[Unit]
Description=Camera Effects virtual video device
After=systemd-modules-load.service
ConditionPathExists=/dev/v4l2loopback

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent: only add the device if a loopback with our label is not there yet.
ExecStart=/bin/sh -c 'v4l2loopback-ctl list 2>/dev/null | grep -q "$LABEL" || v4l2loopback-ctl add -n "$LABEL" -x 1 -o 16 /dev/video$NR'

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable camera-effects-device.service >/dev/null 2>&1 || true
  systemctl restart camera-effects-device.service
  # A root-owned copy of this script: the shell pkexecs that one (not the
  # user-writable copy in ~/.local) once it exists. Refreshed from the caller's
  # copy (owner-checked) on every install, so `./install.sh` and the panel's
  # Install button keep it current; without a source, from the running script.
  install -d -m 755 "$LIBDIR"
  if [[ -n $src ]]; then
    install_privileged_script "$src"
  else
    local self; self=$(readlink -f "$0")
    [[ $self == "$LIBDIR/camera-effects-setup" ]] || install -m 755 -o root -g root "$self" "$LIBDIR/camera-effects-setup"
  fi
  # Cameras hidden => the shell runs the privileged daemon copy: keep it in step
  # with the build being installed (the caller passes its camera-effects-server path).
  if [[ -n $bin ]] && ls "$RULES_DIR"/71-camera-effects-hide-*.rules >/dev/null 2>&1; then
    install_privileged_daemon "$bin"
    echo "privileged daemon refreshed"
  fi
  # Loud failures: a kernel updated but not rebooted (running kernel != installed
  # headers), a failed dkms build, or missing headers all leave the module unloadable.
  if [[ ! -e /dev/v4l2loopback ]]; then
    echo "v4l2loopback is not loadable for the running kernel $(uname -r): reboot if the kernel was just updated, otherwise check 'dkms status' and 'sudo modprobe v4l2loopback'" >&2
    exit 1
  fi
  # udev needs a moment to apply the ACL for the seat user
  sleep 0.3
  local dev; dev=$(device_path)
  if [[ -z $dev ]]; then
    echo "the virtual camera was not created: see 'systemctl status camera-effects-device' and 'v4l2loopback-ctl list'" >&2
    exit 1
  fi
  echo "virtual camera: $dev"
}

raw_devices() {
  # every video4linux node that is not a virtual (loopback) device
  local d
  for d in /sys/class/video4linux/video*; do
    [[ -e $d ]] || continue
    case "$(readlink -f "$d")" in */devices/virtual/*) continue;; esac
    echo "/dev/$(basename "$d")"
  done
}

# Open a caller-supplied source file on fd 3 and check it there: a plain, executable
# regular file owned by the invoking user (or root's when root itself calls). Every
# check and the copy go through that descriptor, so the path cannot be swapped
# between check and copy.
open_owned_exec() {
  local path=$1
  [[ -n $path && ! -L $path ]] || { echo "$2 missing or a symlink: $path" >&2; exit 1; }
  exec 3<"$path" || { echo "cannot open $path" >&2; exit 1; }
  local caller=${PKEXEC_UID:-${SUDO_UID:-0}}
  local st; st=$(stat -L -c '%u %F' /dev/fd/3)
  [[ $st == "$caller regular file" && -x /dev/fd/3 ]] || { echo "refusing $path: must be an executable regular file owned by uid $caller (got: $st)" >&2; exit 1; }
}

# Root-owned setgid copy of the daemon: the only thing allowed to read hidden webcams.
# The source must be the invoking user's file: this publishes it setgid, so it must
# not be pointed at someone else's file. The copy is 2750 root:camerad plus an ACL
# granting rx to the invoking user only, so other local accounts cannot run it to
# reach the hidden webcams (hiding a camera must not widen its audience).
install_privileged_daemon() {
  open_owned_exec "${1:-}" "camera-effects-server binary"
  local caller=${PKEXEC_UID:-${SUDO_UID:-0}}
  getent group "$GROUP" >/dev/null || groupadd -r "$GROUP"
  install -d -m 755 "$LIBDIR"
  # install replaces the destination inode, so no stale ACL survives from a previous copy
  install -m 2750 -o root -g "$GROUP" /dev/fd/3 "$LIBDIR/camera-effects-server"
  exec 3<&-
  [[ $caller -eq 0 ]] || setfacl -m "u:$caller:rx" "$LIBDIR/camera-effects-server"
}

# Root-owned copy of this script (what the shell pkexecs), from the caller's copy.
install_privileged_script() {
  open_owned_exec "${1:-}" "camera-effects-setup script"
  install -d -m 755 "$LIBDIR"
  install -m 755 -o root -g root /dev/fd/3 "$LIBDIR/camera-effects-setup"
  exec 3<&-
}

# udev match for one USB camera from our (validated) key "usb-<vid>-<pid>[-<serial>]".
# The serial is only in the key when it is plain [A-Za-z0-9._], so it can be matched
# verbatim; a camera whose serial did not fit has no serial in its key and is matched
# by vendor/product only.
key_match() {
  local key=$1 vid pid serial
  valid_key "$key"
  IFS=- read -r _ vid pid serial <<<"$key"
  local m="ATTRS{idVendor}==\"$vid\", ATTRS{idProduct}==\"$pid\""
  [[ -n $serial ]] && m+=", ATTRS{serial}==\"$serial\""
  echo "$m"
}

# Our key for a physical device node, same rules as the daemon (capture.cpp).
device_key() {
  local base; base=$(readlink -f "/sys/class/video4linux/$(basename "$1")/device")/..
  local vid pid serial
  vid=$(cat "$base/idVendor" 2>/dev/null || true); pid=$(cat "$base/idProduct" 2>/dev/null || true)
  serial=$(cat "$base/serial" 2>/dev/null || true)
  [[ $vid =~ ^[0-9a-fA-F]{4}$ && $pid =~ ^[0-9a-fA-F]{4}$ ]] || return 0
  [[ $serial =~ ^[A-Za-z0-9._]{1,64}$ ]] || serial=
  echo "usb-$vid-$pid${serial:+-$serial}"
}

# What the hide-all rule matches: a USB device node with a capture capability.
is_usb_capture() {
  local sys; sys=/sys/class/video4linux/$(basename "$1")
  [[ -e $(readlink -f "$sys/device")/../idVendor ]] || return 1
  udevadm info -q property -p "$sys" 2>/dev/null | grep -q '^ID_V4L_CAPABILITIES=.*:capture:'
}

# Re-evaluate udev for cameras and fix ACL/group state to match the rules.
# udev applies rules asynchronously and never removes ACLs it added, so after
# settling we enforce the state the rules describe.
reapply() {
  udevadm control --reload
  udevadm trigger --subsystem-match=video4linux --action=change
  udevadm settle --timeout=5 || true
  local d key hidden
  for d in $(raw_devices); do
    hidden=false
    [[ -f $RULE_ALL ]] && is_usb_capture "$d" && hidden=true
    key=$(device_key "$d")
    [[ -n $key && -f $RULES_DIR/71-camera-effects-hide-$key.rules ]] && hidden=true
    if $hidden; then
      chgrp "$GROUP" "$d" 2>/dev/null || true; chmod 0660 "$d" 2>/dev/null || true
      setfacl -b "$d" 2>/dev/null || true
    else
      chgrp video "$d" 2>/dev/null || true
    fi
  done
}

cmd_hide_raw() {
  need_root
  local mode=${1:-}
  case "$mode" in
    on)
      local bin=${2:-} key=${3:-}
      [[ -z $key ]] || valid_key "$key"
      install_privileged_daemon "$bin"
      if [[ -z $key ]]; then
        # Only USB capture cameras: not tuners, capture cards or codec (M2M) nodes.
        cat > "$RULE_ALL" <<EOF
# Camera Effects: physical webcams are read by the effects daemon only; apps use the
# virtual "Camera Effects" device instead. Toggle "Hide raw cameras" in the panel to restore.
SUBSYSTEM=="video4linux", SUBSYSTEMS=="usb", ENV{ID_V4L_CAPABILITIES}=="*:capture:*", TAG-="uaccess", GROUP="$GROUP", MODE="0660"
EOF
        echo "raw cameras hidden"
      else
        local match; match=$(key_match "$key")
        cat > "$RULES_DIR/71-camera-effects-hide-$key.rules" <<EOF
# Camera Effects: this webcam is read by the effects daemon only (see the Camera panel).
SUBSYSTEM=="video4linux", $match, TAG-="uaccess", GROUP="$GROUP", MODE="0660"
EOF
        echo "camera $key hidden"
      fi
      reapply
      ;;
    off)
      local key=${2:-}
      if [[ -z $key ]]; then rm -f "$RULE_ALL"; echo "raw cameras visible"
      else valid_key "$key"; rm -f "$RULES_DIR/71-camera-effects-hide-$key.rules"; echo "camera $key visible"; fi
      reapply
      ;;
    *) echo "usage: hide-raw on <camera-effects-server> [<key>] | hide-raw off [<key>]" >&2; exit 2;;
  esac
}

# After a rebuild: make the setgid copy match the new build without touching rules.
cmd_refresh_daemon() {
  need_root
  install_privileged_daemon "${1:-}"
  echo "privileged daemon refreshed"
}

cmd_uninstall() {
  need_root
  # Hide rules first: with them gone, reapply hands the webcams back to group video.
  rm -f "$RULES_DIR"/71-camera-effects-hide-*.rules
  reapply || true
  systemctl disable --now camera-effects-device.service >/dev/null 2>&1 || true
  rm -f "$UNIT" "$MODLOAD" "$MODPROBE"
  systemctl daemon-reload
  local dev; dev=$(device_path)
  [[ -n $dev ]] && v4l2loopback-ctl delete "$dev" || true
  rm -rf "$LIBDIR"
  echo "removed: device, boot unit, hide rules, $LIBDIR"
  echo "left in place: group $GROUP, ~/.config/camera-effects/config.json, packages (v4l2loopback-dkms/-utils, onnxruntime); the module stays loaded until reboot"
}

cmd_status() {
  local dev; dev=$(device_path 2>/dev/null || true)
  local hide=false; [[ -f $RULE_ALL ]] && hide=true
  local unit=false; [[ -f $UNIT ]] && unit=true
  local per; per=$(ls "$RULES_DIR"/71-camera-effects-hide-usb-*.rules 2>/dev/null | sed 's|.*/71-camera-effects-hide-||;s|\.rules$||' | paste -sd, - || true)
  printf '{"device":"%s","hideRaw":%s,"hiddenCameras":"%s","bootUnit":%s}\n' "$dev" "$hide" "$per" "$unit"
}

case "${1:-}" in
  install) cmd_install "${2:-}" "${3:-}";;
  uninstall) cmd_uninstall;;
  hide-raw) shift; cmd_hide_raw "$@";;
  refresh-daemon) cmd_refresh_daemon "${2:-}";;
  status) cmd_status;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2;;
esac
